# ansible-vault password for infra-ansible-inventory. Resolved by
# tools/vault/get-vault-pass.sh in that repository (ANSIBLE_VAULT_PASSWORD
# env var, falling back to vault/.vault-pass on disk). See
# docs/runbook-secret-rotation.md for rotation and docs/safety.md for scope.
ANSIBLE_VAULT_PASSWORD=

# Local object-storage validation only. Runtime values normally come from
# infra-ansible-inventory's ansible-vault.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TOKEN=
