      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::syn-cnesdata-state-123456789012",
        "arn:aws:s3:::syn-budget-state-123456789012"
      ]
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::syn-cnesdata-state-123456789012/bootstrap/foundation.tfstate",
        "arn:aws:s3:::syn-budget-state-123456789012/bootstrap/backend.tfstate",
        "arn:aws:s3:::syn-cnesdata-state-123456789012/bootstrap/foundation.tfstate.tflock",
