        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketLogging",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPolicy",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::syn-cnesdata-state-123456789012",
        "arn:aws:s3:::syn-budget-state-123456789012",
        "arn:aws:s3:::syn-cnesdata-logs-123456789012",
        "arn:aws:s3:::syn-budget-logs-123456789012"
      ]
    },
    {
      "Action": [
