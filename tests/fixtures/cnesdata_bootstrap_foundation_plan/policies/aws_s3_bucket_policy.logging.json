{
  "Statement": [
    {
      "Action": [
        "s3:*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      },
      "Effect": "Deny",
      "Principal": "*",
      "Resource": [
        "arn:aws:s3:::syn-cnesdata-logs-123456789012",
        "arn:aws:s3:::syn-cnesdata-logs-123456789012/*"
      ]
    },
    {
      "Action": [
        "s3:PutObject"
      ],
      "Condition": {
        "ArnLike": {
          "aws:SourceArn": "arn:aws:s3:::syn-cnesdata-state-123456789012"
        },
        "StringEquals": {
          "aws:SourceAccount": "123456789012"
        }
      },
      "Effect": "Allow",
      "Principal": {
        "Service": [
          "logging.s3.amazonaws.com"
        ]
      },
      "Resource": [
        "arn:aws:s3:::syn-cnesdata-logs-123456789012/access/syn-cnesdata-state-123456789012/*"
      ]
    }
  ],
  "Version": "2012-10-17"
}
