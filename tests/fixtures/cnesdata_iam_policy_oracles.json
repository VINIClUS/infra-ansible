{
  "bootstrap": {
    "module.runtime_iam.aws_iam_role_policy.execution": {
      "name": "cnesdata-prod-processor-pull-logs",
      "role": "cnesdata-prod-processor-execution",
      "policy": {
        "Statement": [
          {
            "Action": [
              "ecr:BatchGetImage",
              "ecr:GetDownloadUrlForLayer",
              "ecr:BatchCheckLayerAvailability"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:ecr:us-east-2:123456789012:repository/cnesdata-prod-processor"
          },
          {
            "Action": "ecr:GetAuthorizationToken",
            "Effect": "Allow",
            "Resource": "*"
          },
          {
            "Action": [
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:logs:us-east-2:123456789012:log-group:/ecs/cnesdata-prod-processor:log-stream:*"
          }
        ],
        "Version": "2012-10-17"
      }
    },
    "module.runtime_iam.aws_iam_role_policy.runtime[\"unit\"]": {
      "name": "cnesdata-prod-processor-unit-runtime",
      "role": "cnesdata-prod-processor-unit",
      "policy": {
        "Statement": [
          {
            "Action": [
              "states:DescribeStateMachine",
              "states:StartExecution"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:states:us-east-2:123456789012:stateMachine:cnesdata-prod"
          },
          {
            "Action": [
              "states:DescribeExecution",
              "states:StopExecution"
            ],
            "Effect": "Allow",
            "Resource": "arn:aws:states:us-east-2:123456789012:execution:cnesdata-prod:*"
          },
          {
            "Action": [
              "dynamodb:GetItem",
              "dynamodb:Query",
              "dynamodb:ConditionCheckItem",
              "dynamodb:PutItem",
              "dynamodb:UpdateItem",
              "dynamodb:DeleteItem"
            ],
            "Condition": {
              "ForAllValues:StringLike": {
                "dynamodb:LeadingKeys": [
                  "TENANT#*",
                  "TENANT#*#RUN#*",
                  "TENANT#_GLOBAL",
                  "ENV#prod#FENCE",
                  "ENV#prod#SEMAPHORE"
                ]
              },
              "Null": {
                "dynamodb:LeadingKeys": "false"
              }
            },
            "Effect": "Allow",
            "Resource": "arn:aws:dynamodb:us-east-2:123456789012:table/cnesdata-prod-control-plane"
          },
          {
            "Action": "dynamodb:UpdateItem",
            "Condition": {
              "ForAllValues:StringEquals": {
                "dynamodb:LeadingKeys": [
                  "ENV#prod#ATTEMPTS"
                ]
              },
              "Null": {
                "dynamodb:LeadingKeys": "false"
              }
            },
            "Effect": "Allow",
            "Resource": "arn:aws:dynamodb:us-east-2:123456789012:table/cnesdata-prod-control-plane"
          },
          {
            "Action": "s3:GetObject",
            "Effect": "Allow",
            "Resource": [
              "arn:aws:s3:::cnesdata-prod-data/raw/*",
              "arn:aws:s3:::cnesdata-prod-data/tmp/*",
              "arn:aws:s3:::cnesdata-prod-data/normalized/*",
              "arn:aws:s3:::cnesdata-prod-data/reconciliation/*",
              "arn:aws:s3:::cnesdata-prod-data/serving/*"
            ]
          },
          {
            "Action": "s3:PutObject",
            "Effect": "Allow",
            "Resource": [
              "arn:aws:s3:::cnesdata-prod-data/tmp/*",
              "arn:aws:s3:::cnesdata-prod-data/normalized/*",
              "arn:aws:s3:::cnesdata-prod-data/reconciliation/*",
              "arn:aws:s3:::cnesdata-prod-data/serving/*"
            ]
          },
          {
            "Action": "s3:ListBucket",
            "Condition": {
              "StringLike": {
                "s3:prefix": [
                  "raw/*",
                  "tmp/*",
                  "normalized/*",
                  "reconciliation/*",
                  "serving/*"
                ]
              }
            },
            "Effect": "Allow",
            "Resource": "arn:aws:s3:::cnesdata-prod-data"
          }
        ],
        "Version": "2012-10-17"
      }
    },
