import base64, json, sys, types, zlib
try:
    sources = json.loads(zlib.decompress(base64.b64decode({{ bundle.sources | samba_ad_pilot_pack_sources | to_json }})))
    for name in ['tools', 'tools.samba_ad']:
        package = types.ModuleType(name)
        package.__path__ = []
        sys.modules[name] = package
    sys.modules['tools'].samba_ad = sys.modules['tools.samba_ad']
    for short, source in sources.items():
        full = 'tools.samba_ad.' + short
        module = types.ModuleType(full)
        module.__package__ = 'tools.samba_ad'
        sys.modules[full] = module
        setattr(sys.modules['tools.samba_ad'], short, module)
        exec(source, module.__dict__)
    from tools.samba_ad import pilots
    client_sources = {
        'linux': {{ lookup('ansible.builtin.file', role_path ~ '/../../tools/samba_ad/pilot_linux.py') | to_json }},
        'windows': {{ lookup('ansible.builtin.file', role_path ~ '/../../tools/samba_ad/pilot_windows.ps1') | to_json }}
    }
    raise SystemExit(pilots.main(client_sources))
except Exception:
    print('S6 precondition failed (values suppressed)', file=sys.stderr)
    raise SystemExit(2)
