[Unit]
Description=Samba AD PKI rotation {{ samba_ad_pki_request.profile }}
After=network.target
[Service]
Type=oneshot
WorkingDirectory=/usr/libexec/samba-ad-pki
ExecStart=/usr/bin/python3 -B -m tools.samba_ad.pki_runtime --execute --request-file /etc/samba-ad-pki/requests/{{ samba_ad_pki_request.profile }}.json
TimeoutStartSec=90s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ samba_ad_pki_request.state_dir }} /run
