# Owned AD backend; no changes to the shared Prometheus unit, storage or retention.
global:
  scrape_interval: 30s
  evaluation_interval: 30s
rule_files:
  - /etc/samba-ad-observability/prometheus-rules.yml
scrape_configs:
  - job_name: ad_backend
    static_configs:
      - targets: [127.0.0.1:19100, 127.0.0.1:19101, 127.0.0.1:19104]
        labels:
          project: samba-ad
# Deliberately no alertmanagers or outbound notifications.
