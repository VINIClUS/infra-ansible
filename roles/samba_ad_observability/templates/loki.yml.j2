auth_enabled: true
server:
  http_listen_address: 127.0.0.1
  http_listen_port: 19101
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: 19103
common:
  instance_addr: 127.0.0.1
  path_prefix: /var/lib/samba-ad-observability-loki
  storage:
    filesystem:
      chunks_directory: /var/lib/samba-ad-observability-loki/chunks
      rules_directory: /var/lib/samba-ad-observability-loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
schema_config:
  configs:
    - from: 2026-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: ad_index_
        period: 24h
limits_config:
  retention_period: 168h
  reject_old_samples: true
  reject_old_samples_max_age: 48h
  max_query_series: 1000
compactor:
  working_directory: /var/lib/samba-ad-observability-loki/compactor
  retention_enabled: true
  delete_request_store: filesystem
ruler:
  storage:
    type: local
    local:
      directory: /etc/samba-ad-observability/loki-rules
  rule_path: /var/lib/samba-ad-observability-loki/ruler-tmp
  enable_api: true
  enable_alertmanager_v2: true
  alertmanager_url: ""
  ring:
    kvstore:
      store: inmemory
analytics:
  reporting_enabled: false
