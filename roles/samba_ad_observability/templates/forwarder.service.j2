[Unit]
Description=Authenticated Samba AD durable telemetry queue
After=network-online.target
[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/samba-ad-observability/telemetry_spool.py /etc/samba-ad-observability/agent.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/samba-ad-observability
MemoryMax=256M
TasksMax=64
[Install]
WantedBy=multi-user.target
