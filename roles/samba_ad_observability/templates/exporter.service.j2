[Unit]
Description=Read-only Samba AD telemetry signals
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/samba-ad-observability/telemetry.py
TimeoutStartSec=180
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/samba-ad-observability
