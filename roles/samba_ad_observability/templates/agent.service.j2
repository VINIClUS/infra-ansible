[Unit]
Description=Dedicated Samba AD telemetry transport
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=root
UMask=0077
ExecStart=/opt/samba-ad-observability/bin/alloy run --stability.level=experimental --server.http.listen-addr=127.0.0.1:19102 --storage.path=/var/lib/samba-ad-observability/alloy /etc/samba-ad-observability/agent.alloy
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/samba-ad-observability
[Install]
WantedBy=multi-user.target
